/* =============================================================================
 * Jenkinsfile — COGSI / Pipelines Part 2
 * -----------------------------------------------------------------------------
 * Purpose:
 * - Demonstrates advanced Jenkins Pipeline concepts.
 * - Extends the simple pipeline with branch-aware execution and parallelism.
 *
 * Key Concepts:
 * - Conditional execution using when.
 * - Branch-aware execution in Multibranch Pipelines.
 * - Parameters and environment variables.
 * - Parallel execution of independent validation tasks.
 * - Multibranch Pipeline integration through BRANCH_NAME.
 * - Artifact archiving and post-build actions.
 *
 * Note:
 * - Multibranch Pipeline configuration and build triggers are configured
 *   in Jenkins and GitHub, respectively.
 * - Deployment stages are illustrative placeholders.
 * =============================================================================
 */

pipeline {

    /*
     * Defines where the pipeline can run.
     * Jenkins may use any available executor.
     */
    agent any

    /*
     * Operational safeguards and logging improvements.
     */
    options {

        // Prevents builds from hanging indefinitely
        timeout(time: 20, unit: 'MINUTES')

        // Adds timestamps to console output
        timestamps()

        // Prevents overlapping executions
        disableConcurrentBuilds()

        // Disables automatic checkout because it is performed explicitly
        skipDefaultCheckout(true)
    }

    /*
     * Runtime customization.
     */
    parameters {

        // Controls artifact archiving
        booleanParam(
            name: 'ARCHIVE_ARTIFACTS',
            defaultValue: true,
            description: 'Archive generated build artifacts'
        )
    }

    /*
     * Global reusable variables.
     */
    environment {

        APP_NAME = 'gradle_demo'
        PROJECT_DIR = 'build_tools/gradle_demo'

        // Used to demonstrate environment-based conditional execution
        TEST_ENABLED = 'true'
    }

    stages {

        /*
         * Retrieves the source code corresponding to the
         * branch and revision selected by the Multibranch Pipeline.
         */
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        /*
         * Demonstrates environment awareness and branch context.
         */
        stage('Verify Context') {
            steps {

                echo "Application: ${env.APP_NAME}"
                echo "Branch: ${env.BRANCH_NAME ?: 'N/A (non-multibranch job)'}"
                echo "Build Number: ${env.BUILD_NUMBER}"
                echo "Workspace: ${env.WORKSPACE}"

                sh '''
                    echo "Shell Context:"
                    echo "JOB_NAME=$JOB_NAME"
                    echo "BUILD_NUMBER=$BUILD_NUMBER"
                    echo "BRANCH_NAME=$BRANCH_NAME"
                '''
            }
        }

        /*
         * Compiles the application without running tests.
         */
        stage('Build') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean classes
                    '''
                }
            }
        }

        /*
         * Demonstrates parallel execution of independent
         * validation tasks.
         */
        stage('Parallel Validation') {

            parallel {

                /*
                 * Executes unit tests when TEST_ENABLED=true.
                 */
                stage('Unit Tests') {

                    when {
                        environment name: 'TEST_ENABLED', value: 'true'
                    }

                    steps {
                        dir("${PROJECT_DIR}") {
                            sh './gradlew test'
                        }
                    }

                    post {
                        always {
                            junit(
                                testResults: "${PROJECT_DIR}/app/build/test-results/test/*.xml",
                                allowEmptyResults: true
                            )
                        }
                    }
                }

                /*
                 * Checks the latest commit for whitespace errors.
                 * This task is independent of the Gradle test execution.
                 */
                stage('Source Validation') {
                    steps {
                        dir("${PROJECT_DIR}") {
                            sh 'git show --format= --check HEAD'
                        }
                    }
                }
            }
        }

        /*
         * Generates application artifacts after validation.
         */
        stage('Package') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh './gradlew assemble'
                }
            }
        }

        /*
         * Branch-aware deployment logic.
         * These stages illustrate conditional execution.
         * Actual deployment is outside the scope of this example.
         */
        stage('Deploy to Staging') {

            when {
                branch 'development'
            }

            steps {
                echo "Deploying branch ${env.BRANCH_NAME} to staging..."
                echo 'Staging deployment placeholder.'
            }
        }

        stage('Deploy to Production') {

            when {
                branch 'main'
            }

            steps {
                echo "Deploying branch ${env.BRANCH_NAME} to production..."
                echo 'Production deployment placeholder.'
            }
        }

        /*
         * Archives generated artifacts when enabled.
         */
        stage('Archive') {

            when {
                expression { params.ARCHIVE_ARTIFACTS }
            }

            steps {
                dir("${PROJECT_DIR}") {
                    archiveArtifacts(
                        artifacts: 'app/build/libs/*.jar, app/build/distributions/*',
                        fingerprint: true
                    )
                }
            }
        }
    }

    /*
     * Post-build lifecycle actions.
     */
    post {

        always {
            echo "Pipeline finished with status: ${currentBuild.currentResult}"
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review stage logs carefully.'
        }

        cleanup {
            cleanWs()
        }
    }
}
