
/* =============================================================================
 * Jenkinsfile — COGSI / Pipelines Part 1
 * -----------------------------------------------------------------------------
 * Purpose:
 * - Demonstrates a simple Jenkins pipeline for building a Gradle project.
 * - Serves as a starting point to understand basic pipeline structure and stages.
 *
 * Key Concepts:
 * - Declarative Pipeline syntax.
 * - Stages and steps.
 * - Global options, parameters, and environment variables.
 * - SCM checkout to retrieve source code from GitHub.
 * - Build, test, and packaging stages.
 * - Test result publication and artifact archiving.
 * - Post-build actions and workspace cleanup.
 * =============================================================================
 */

pipeline {

    /*
     * Defines where the pipeline can run.
     * Jenkins may use any available executor.
     */
    agent any

    /*
     * Global execution controls.
     */
    options {

        // Prevents builds from hanging indefinitely
        timeout(time: 15, unit: 'MINUTES')

        // Adds timestamps to console output
        timestamps()

        // Prevents overlapping executions of the same pipeline
        disableConcurrentBuilds()

        // Disables automatic checkout because it is performed explicitly
        skipDefaultCheckout(true)
    }

    /*
     * Runtime parameters.
     */
    parameters {

        // Controls whether generated artifacts are archived
        booleanParam(
            name: 'ARCHIVE_ARTIFACTS',
            defaultValue: true,
            description: 'Archive generated application artifacts'
        )
    }

    /*
     * Global environment variables.
     */
    environment {

        // Application/module name
        APP_NAME = 'gradle_demo'

        // Relative path inside the course repository
        PROJECT_DIR = 'build_tools/gradle_demo'

        // Gradle wrapper command
        GRADLE_CMD = './gradlew'
    }

    stages {

        /*
         * Retrieves source code from GitHub.
         */
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/lmpnogueira/cogsi.git'
            }
        }

        /*
         * Demonstrates Jenkins runtime metadata
         * and environment variable access.
         */
        stage('Verify Environment') {
            steps {

                // Accessing variables from Groovy
                echo "Application: ${env.APP_NAME}"
                echo "Job Name: ${env.JOB_NAME}"
                echo "Build Number: ${env.BUILD_NUMBER}"
                echo "Workspace: ${env.WORKSPACE}"

                // Accessing variables from the shell
                sh '''
                    echo "Shell Environment:"
                    echo "JOB_NAME=$JOB_NAME"
                    echo "BUILD_NUMBER=$BUILD_NUMBER"
                    echo "WORKSPACE=$WORKSPACE"
                '''
            }
        }

        /*
         * Compiles the application without running tests.
         */
        stage('Build') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean classes
                    '''
                }
            }
        }

        /*
         * Executes unit tests and publishes their results.
         */
        stage('Test') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh "${GRADLE_CMD} test"
                }
            }

            post {
                always {
                    junit(
                        testResults: "${PROJECT_DIR}/app/build/test-results/test/*.xml"
                        allowEmptyResults: true
                    )
                }
            }
        }

        /*
         * Generates application artifacts.
         */
        stage('Package') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh "${GRADLE_CMD} assemble"
                }
            }
        }

        /*
         * Archives generated artifacts for download,
         * traceability, and future use.
         */
        stage('Archive') {

            when {
                expression { params.ARCHIVE_ARTIFACTS }
            }

            steps {
                dir("${PROJECT_DIR}") {
                    archiveArtifacts(
                        artifacts: 'app/build/libs/*.jar, app/build/distributions/*',
                        fingerprint: true
                    )
                }
            }
        }
    }

    /*
     * Actions executed after pipeline completion.
     */
    post {

        // Runs regardless of the pipeline outcome
        always {
            echo "Pipeline finished with status: ${currentBuild.currentResult}"
        }

        // Success-specific feedback
        success {
            echo 'Build completed successfully.'
        }

        // Failure-specific feedback
        failure {
            echo 'Build failed. Review console output for details.'
        }

        // Cleanup after pipeline execution
        cleanup {
            cleanWs()
        }
    }
}
