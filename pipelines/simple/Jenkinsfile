/*
 * Jenkinsfile — COGSI / Pipelines Part 1 
 *
 * Purpose:
 * - Demonstrates a simple Jenkins pipeline for building a Gradle project.
 * - Serves as a starting point to understand basic pipeline structure and stages.
 *
 * Key Concepts:
 * - Declarative pipeline syntax for readability and maintainability.
 * - Use of stages to organize build steps logically.
 * - Global options, parameters, and environment variables for consistent execution.
 * - SCM checkout to retrieve source code from GitHub.
 * - Artifact archiving to preserve build outputs.
 * - Post actions for cleanup and notifications.    
 */

pipeline {

    /*
     * Defines where the pipeline can run.
     * For simplicity, Jenkins may use any available executor.
     */
    agent any

    /*
     * Global execution controls improve safety,
     * readability, and reproducibility.
     */
    options {

        // Prevents builds from hanging indefinitely
        timeout(time: 15, unit: 'MINUTES')

        // Adds timestamps to console output
        timestamps()

        // Prevents overlapping executions of the same pipeline
        disableConcurrentBuilds()
    }

    /*
     * Runtime parameters allow controlled customization
     * without editing the Jenkinsfile itself.
     */
    parameters {

        // Selects the Gradle build profile
        choice(
            name: 'BUILD_PROFILE',
            choices: ['dev', 'prod'],
            description: 'Select the Gradle build profile'
        )

        // Allows artifact archiving to be toggled
        booleanParam(
            name: 'ARCHIVE_ARTIFACTS',
            defaultValue: true,
            description: 'Archive generated distribution artifacts'
        )
    }

    /*
     * Global environment variables reused across stages.
     */
    environment {

        // Name of the application/module
        APP_NAME = 'gradle_demo'

        // Relative path inside the course repository
        PROJECT_DIR = 'build_tools/gradle_demo'

        // Standardized Gradle wrapper command
        GRADLE_CMD = './gradlew'

        // Expected output location for packaged artifacts
        ARTIFACT_DIR = 'build/distributions'
    }

    stages {

        /*
         * Retrieves the project source code from GitHub.
         * Explicit repository and branch improve consistency.
         */
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/lmpnogueira/cogsi.git'
            }
        }

        /*
         * Demonstrates how Jenkins exposes useful runtime metadata.
         * Uses environment variables in both Groovy and shell contexts.
         */
        stage('Verify Environment') {
            steps {

                // Accessing variables from Groovy
                echo "Application: ${env.APP_NAME}"
                echo "Job Name: ${env.JOB_NAME}"
                echo "Build Number: ${env.BUILD_NUMBER}"
                echo "Workspace: ${env.WORKSPACE}"
                echo "Selected Profile: ${params.BUILD_PROFILE}"

                // Accessing variables from shell
                sh '''
                    echo "Shell Environment:"
                    echo "JOB_NAME=$JOB_NAME"
                    echo "BUILD_NUMBER=$BUILD_NUMBER"
                    echo "WORKSPACE=$WORKSPACE"

                    # Ensure Gradle wrapper can execute
                    chmod +x ${WORKSPACE}/${PROJECT_DIR}/gradlew
                '''
            }
        }

        /*
         * Compiles the application.
         * Tests are intentionally excluded. 
         */
        stage('Build') {
            steps {

                dir("${PROJECT_DIR}") {

                    sh """
                        # Clean previous outputs
                        # Build using selected profile
                        ${GRADLE_CMD} clean build -Pprofile=${params.BUILD_PROFILE} -x test
                    """
                }
            }
        }

        /*
         * Generates distributable artifacts separately.
         * Reinforces CI stage separation.
         */
        stage('Package') {
            steps {

                dir("${PROJECT_DIR}") {

                    sh """
                        # Assemble distribution artifacts
                        ${GRADLE_CMD} assemble -Pprofile=${params.BUILD_PROFILE}
                    """
                }
            }
        }

        /*
         * Archives generated artifacts for download,
         * traceability, or downstream usage.
         */
        stage('Archive') {

            /*
             * Stage executes only if archiving
             * is enabled through parameters.
             */
            when {
                expression { params.ARCHIVE_ARTIFACTS }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    archiveArtifacts(
                        artifacts: "${ARTIFACT_DIR}/*",
                        fingerprint: true
                    )
                }
            }
        }
    }

    /*
     * Actions executed after pipeline completion.
     */
    post {

        /*
         * Runs regardless of outcome.
         */
        always {
            echo "Pipeline finished with status: ${currentBuild.currentResult}"
        }

        /*
         * Success-specific feedback.
         */
        success {
            echo 'Build completed successfully.'
        }

        /*
         * Failure-specific feedback.
         */
        failure {
            echo 'Build failed. Review console output for details.'
        }

        /*
         * Cleanup avoids workspace accumulation
         * across multiple executions.
         */
        cleanup {
            cleanWs()
        }
    }
}
